    <qresource prefix="/sounds">
        <file alias="newMessageSound">newMessage.wav</file>
    </qresource>
    <qresource prefix="/images">
        <file>enot.png</file>
        <file>enot_windows.ico</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="circle.svg">icons/circle.svg</file>
        <file alias="search.svg">icons/search.svg</file>
        <file alias="left_panel_open.svg">icons/left_panel_open.svg</file>
        <file alias="left_panel_close.svg">icons/left_panel_close.svg</file>
    </qresource>
</RCC>
