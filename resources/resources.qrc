<RCC>
    <qresource prefix="/styles">
        <file alias="main.qss">styles/main.qss</file>
        <file alias="customization-color-rule.qss">styles/customization-color-rule.qss</file>
        <file alias="customization-targets.json">styles/customization-targets.json</file>
        <file alias="login-button-animation.qss">styles/login-button-animation.qss</file>
    </qresource>
    <qresource prefix="/sounds">
        <file alias="newMessageSound">newMessage.wav</file>
    </qresource>
    <qresource prefix="/images">
        <file>enot.png</file>
        <file>enot_windows.ico</file>
    </qresource>
    <qresource prefix="/icons">
        <file alias="circle.svg">icons/circle.svg</file>
        <file alias="search.svg">icons/search.svg</file>
        <file alias="left_panel_open.svg">icons/left_panel_open.svg</file>
        <file alias="left_panel_close.svg">icons/left_panel_close.svg</file>
        <file alias="attach.svg">icons/attach.svg</file>
        <file alias="send.svg">icons/send.svg</file>
        <file alias="back.svg">icons/back.svg</file>
        <file alias="edit.svg">icons/edit.svg</file>
        <file alias="delete.svg">icons/delete.svg</file>
        <file alias="settings.svg">icons/settings.svg</file>
        <file alias="palette.svg">icons/palette.svg</file>
    </qresource>
</RCC>
