QPushButton#logInBtn, QPushButton#switchToRegistrationBtn, QPushButton#registrationBtn, QPushButton#switchToLogInBtn { background-color: #141414; color: #E6E8EB; border: 1px solid #333333; border-radius: 15px; padding: 6px 10px; }
QPushButton#logInBtn:hover, QPushButton#switchToRegistrationBtn:hover, QPushButton#registrationBtn:hover, QPushButton#switchToLogInBtn:hover { background-color: #1F1F1F; }
QPushButton#logInBtn:pressed, QPushButton#switchToRegistrationBtn:pressed, QPushButton#registrationBtn:pressed, QPushButton#switchToLogInBtn:pressed { background-color: #0F0F0F; }
