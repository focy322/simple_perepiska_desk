  <property name="styleSheet">
   <string notr="true">QMainWindow, QWidget { background-color: #0A0A0A; color: #E6E8EB; font-family: "Segoe UI"; }
QLabel { color: #E6E8EB; }
QLineEdit { background-color: #1B1F24; color: #E6E8EB; border: 1px solid #2A3037; selection-background-color: #2F6BFF; }
QLineEdit:focus { border: 1px solid #3E7BFF; }
QTextEdit { background-color: #0A0A0A; color: #E6E8EB; border: none; padding: 6px 8px; selection-background-color: #2F6BFF; }
QTextEdit:focus { border: none; }
QPushButton { background-color: #242A31; color: #E6E8EB; border: 1px solid #2F3740; border-radius: 6px; padding: 6px 10px; outline: none; }
QPushButton:hover { background-color: #3a4551; }
QPushButton:pressed { background-color: #1F252B; }
QListView { background-color: #14181C; border: none; }
QScrollBar:vertical { background: #111418; width: 10px; margin: 2px; }
QScrollBar::handle:vertical { background: #2B323A; border-radius: 5px; min-height: 20px; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0px; }
QScrollBar::add-page:vertical,QScrollBar::sub-page:vertical { background: #111418;}
QScrollBar:horizontal { background: #111418; height: 10px; margin: 2px; }
QScrollBar::handle:horizontal { background: #2B323A; border-radius: 5px; min-width: 20px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0px; }
QScrollBar::add-page:horizontal,QScrollBar::sub-page:horizontal { background: #111418;}</string>
